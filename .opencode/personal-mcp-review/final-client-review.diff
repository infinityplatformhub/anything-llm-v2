+const caller = require("./personalCaller");
+const oauth = require("./oauth");
+const { validateWorkspaceServerConfig } = require("./serverConfig");
+
+class PersonalMcpRuntime {
+  clients = new Map();
+  boots = new Map();
+  epochs = new Map();
+  constructor(hypervisor) {
+    this.hypervisor = hypervisor;
+  }
