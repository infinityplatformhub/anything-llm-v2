+import { useEffect, useState } from "react";
+import WorkspaceMcp from "@/models/workspaceMcp";
+
+export default function PersonalMcpConnections({ workspaceSlug }) {
+  const [servers, setServers] = useState([]);
+  const [busy, setBusy] = useState(null);
+  const [message, setMessage] = useState("");
+  useEffect(() => {
+    let alive = true;
+    WorkspaceMcp.personal(workspaceSlug)
+      .then((rows) => {
+        if (alive) setServers(rows);
+      })
+      .catch(() => {
+        if (alive) setServers([]);
+      });
+    return () => {
+      alive = false;
+    };
+  }, [workspaceSlug]);
+  async function action(server, connect) {
+    if (busy) return;
+    setBusy(server.name);
+    setMessage("");
+    try {
+      if (connect) {
+        const url = await WorkspaceMcp.start(workspaceSlug, server.name);
+        window.location.assign(url);
+      } else {
+        const result = await WorkspaceMcp.disconnect(
+          workspaceSlug,
+          server.name
+        );
+        setServers(await WorkspaceMcp.personal(workspaceSlug));
+        if (!result.remoteRevoked)
+          setMessage(
+            "Disconnected locally. Remote revocation could not be confirmed."
+          );
+      }
+    } catch {
+      setMessage(
+        "Connection unavailable. Try again or contact your workspace administrator."
+      );
+    } finally {
+      setBusy(null);
+    }
+  }
+  if (!servers.length) return null;
+  return (
+    <details className="absolute right-4 top-14 z-20 rounded-lg bg-zinc-800 light:bg-white border border-theme-modal-border p-3 text-sm text-white light:text-slate-900 max-w-sm">
+      <summary className="cursor-pointer">My MCP connections</summary>
+      <p className="mt-2 text-xs">
+        Only your account is connected. Personal tool replies are not saved in
+        shared history.
+      </p>
+      {servers.map((server) => (
+        <div
+          key={server.name}
+          className="flex gap-3 items-center justify-between mt-3"
+        >
+          <span>
+            {server.name}:{" "}
+            {server.connected
+              ? "Connected"
+              : server.needsReauth
+                ? "Reconnect required"
+                : "Not connected"}
+            {server.connected && server.accountLabel && (
+              <span className="block text-xs">{server.accountLabel}</span>
+            )}
+          </span>
+          <button
+            type="button"
+            disabled={!!busy}
+            onClick={() => action(server, !server.connected)}
+            className="rounded px-3 py-1 bg-blue-600 disabled:opacity-50"
+          >
+            {busy === server.name
+              ? "Working…"
+              : server.connected
+                ? "Disconnect"
+                : "Connect"}
+          </button>
+        </div>
+      ))}
+      {message && (
+        <p role="status" className="mt-3 text-xs">
+          {message}
+        </p>
+      )}
+    </details>
+  );
+}

