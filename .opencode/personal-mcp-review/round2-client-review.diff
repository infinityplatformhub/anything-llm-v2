+let workspace, a, b, ca, cb, layer, config, logs;
+beforeAll(async () => {
+  process.env.SIG_KEY ||= "personal-test-key";
+  process.env.SIG_SALT ||= "personal-test-salt";
+  workspace = await prisma.workspaces.create({
