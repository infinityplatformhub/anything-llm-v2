+      if (body.method === "initialize")
+        return res.end(
+          JSON.stringify({
+            jsonrpc: "2.0",
+            id: body.id,
+            result: {
+              protocolVersion: "2025-03-26",
+              capabilities: { tools: {} },
+              serverInfo: { name: "mutation-fixture", version: "1" },
+            },
+          })
+        );
+      if (body.method === "notifications/initialized") {
+        res.statusCode = 202;
+        return res.end();
