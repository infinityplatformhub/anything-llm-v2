+    expect(result.every((item) => item.status === "rejected")).toBe(true);
+    expect(refresh).toHaveBeenCalledTimes(1);
+    expect(Client).not.toHaveBeenCalled();
+    expect(
+      (await Grant.find(workspace.id, a.id, "medusa", config)).access_token
