+const { describe, it, expect } = require("@jest/globals");
+const fs = require("fs");
+const path = require("path");
+const vm = require("vm");
+const frontend = path.resolve(__dirname, "../../../../frontend/src");
+describe("personal frontend contract", () => {
+  it("accepts personal opt-in but rejects mixed workspace/personal auth", () => {
+    const source = fs
+      .readFileSync(path.join(frontend, "models/workspaceMcp.js"), "utf8")
+      .replace(/^import .*;$/gm, "")
+      .replace(/export default WorkspaceMcp;/, "")
+      .replace(/export /g, "");
+    const context = vm.createContext({ URL, TextEncoder });
+    vm.runInContext(
+      source + ";globalThis.validate = validateMcpConfig;",
+      context
+    );
+    const config = {
+      url: "https://configurable.example/mcp",
+      anythingllm: { perUserAuth: true },
+    };
+    expect(context.validate(config)).toBeNull();
+    expect(
+      context.validate({
+        ...config,
+        anythingllm: { perUserAuth: true, perWorkspaceAuth: true },
+      })
+    ).toBe("invalid_anythingllm");
+  });
+  it("member chat mounts personal controls without navigating to admin settings", () => {
+    const chat = fs.readFileSync(
+      path.join(frontend, "components/WorkspaceChat/ChatContainer/index.jsx"),
+      "utf8"
+    );
+    expect(chat).toContain("<PersonalMcpConnections");
+    const ui = fs.readFileSync(
+      path.join(
+        frontend,
+        "components/WorkspaceChat/ChatContainer/PersonalMcpConnections.jsx"
+      ),
+      "utf8"
+    );
+    expect(ui).toContain("WorkspaceMcp.personal");
+    expect(ui).toContain("WorkspaceMcp.start");
+    expect(ui).toContain("WorkspaceMcp.disconnect");
+    expect(ui).not.toContain("/settings/");
+  });
+});

