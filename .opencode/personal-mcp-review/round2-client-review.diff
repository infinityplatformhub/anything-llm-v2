+      original.version,
+      config
+    );
+    expect(lease).toBe(original.version + 1);
+    expect(
+      await Grant.acquireRefresh(
+        workspace.id,
+        a.id,
+        "medusa",
+        original.version,
+        config
+      )
+    ).toBeNull();
+    await Grant.save(workspace.id, a.id, "medusa", lease, config, {
+      access_token: "refreshed",
+      refresh_token: "rotated",
