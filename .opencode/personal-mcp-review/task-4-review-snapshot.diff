+    const first = await Grant.begin(workspace.id, a.id, 'medusa', config);
+    await Grant.clear(workspace.id, a.id, 'medusa');
+    expect(await Grant.save(workspace.id, a.id, 'medusa', first.version, config, { access_token: 'stale' })).toBe(false);
+    const second = await Grant.begin(workspace.id, a.id, 'medusa', config);
+    expect(await Grant.save(workspace.id, a.id, 'medusa', second.version, config, { access_token: 'fresh' })).toBe(true);
+    expect(await Grant.save(workspace.id, a.id, 'medusa', second.version, config, { access_token: 'stale-refresh' })).toBe(false);
+    expect((await Grant.find(workspace.id, a.id, 'medusa', config)).access_token).toBe('fresh');
+  });
+  it('definition changes invalidate all personal grants and old callback versions', async () => {
+    const first = await Grant.begin(workspace.id, a.id, 'medusa', config);
+    await Grant.invalidate(workspace.id, 'medusa');
+    expect(await Grant.save(workspace.id, a.id, 'medusa', first.version, config, { access_token: 'stale' })).toBe(false);
+    expect(await Grant.find(workspace.id, a.id, 'medusa', { ...config, url: 'https://other.example/mcp' })).toBeNull();
+  });
+  it('database refresh lease is owner scoped and disconnect clears refresh but not reconnect', async () => {
+    const first = await Grant.begin(workspace.id, a.id, 'medusa', config);
+    await Grant.save(workspace.id, a.id, 'medusa', first.version, config, { access_token: 'initial', refresh_token: 'refresh' });
+    const original = await Grant.find(workspace.id, a.id, 'medusa', config);
+    const lease = await Grant.acquireRefresh(workspace.id, a.id, 'medusa', original.version, config);
+    expect(lease).toBe(original.version + 1);
+    expect(await Grant.acquireRefresh(workspace.id, a.id, 'medusa', original.version, config)).toBeNull();
+    await Grant.save(workspace.id, a.id, 'medusa', lease, config, { access_token: 'refreshed', refresh_token: 'rotated' });
+    await Grant.clearGeneration(workspace.id, a.id, 'medusa', original.generation);
+    expect((await Grant.find(workspace.id, a.id, 'medusa', config)).enabled).toBe(false);
+    const newer = await Grant.begin(workspace.id, a.id, 'medusa', config);
+    await Grant.save(workspace.id, a.id, 'medusa', newer.version, config, { access_token: 'reconnected' });
+    await Grant.clearGeneration(workspace.id, a.id, 'medusa', original.generation);
+    expect((await Grant.find(workspace.id, a.id, 'medusa', config)).access_token).toBe('reconnected');
+  });
+  it('requires a verified caller, active user and current membership', async () => {
+    await expect(caller.fromResponse({ locals: { user: a } }, workspace)).rejects.toThrow('personal_auth_required');
+    const response = { locals: { user: a, browserSessionUserId: a.id } };
+    const verified = await caller.fromResponse(response, workspace);
+    expect(await caller.assert(verified, workspace)).toBe(a.id);
+    await expect(caller.assert({ userId: a.id }, workspace)).rejects.toThrow('personal_auth_required');
+    await prisma.users.update({ where: { id: a.id }, data: { suspended: 1 } });
+    await expect(caller.assert(verified, workspace)).rejects.toThrow('personal_auth_required');
+    await prisma.users.update({ where: { id: a.id }, data: { suspended: 0 } });
+    await prisma.workspace_users.deleteMany({ where: { workspace_id: workspace.id, user_id: a.id } });
+    await expect(caller.assert(verified, workspace)).rejects.toThrow('personal_auth_required');
+    await prisma.workspace_users.create({ data: { workspace_id: workspace.id, user_id: a.id } });
+  });
+});

