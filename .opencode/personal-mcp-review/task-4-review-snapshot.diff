+/* global jest */
+const { describe, it, expect, beforeAll, afterAll, beforeEach } = require('@jest/globals');
+require('../../utils/lark/_polyfill');
+const crypto = require('crypto');
+const prisma = require('../../../utils/prisma');
+const { validateWorkspaceServerConfig } = require('../../../utils/MCP/serverConfig');
+let Grant, caller, workspace, a, b;
+const config = { url: 'https://medusa.example/mcp', type: 'http', anythingllm: { perUserAuth: true } };
+beforeAll(async () => {
+  process.env.SIG_KEY ||= 'personal-test-key';
+  process.env.SIG_SALT ||= 'personal-test-salt';
+  workspace = await prisma.workspaces.create({ data: { name: 'Personal MCP', slug: crypto.randomUUID() } });
+  a = await prisma.users.create({ data: { username: crypto.randomUUID(), password: 'unused' } });
+  b = await prisma.users.create({ data: { username: crypto.randomUUID(), password: 'unused' } });
+  for (const user of [a, b]) await prisma.workspace_users.create({ data: { workspace_id: workspace.id, user_id: user.id } });
+});
+beforeEach(async () => {
+  Grant = require('../../../models/personalMcpGrant').PersonalMcpGrant;
+  caller = require('../../../utils/MCP/personalCaller');
+  await prisma.personal_mcp_grants.deleteMany({ where: { workspace_id: workspace.id } });
+});
+afterAll(async () => {
+  if (workspace) await prisma.workspaces.delete({ where: { id: workspace.id } });
+  if (a) await prisma.users.delete({ where: { id: a.id } });
+  if (b) await prisma.users.delete({ where: { id: b.id } });
+  await prisma.$disconnect();
+});
+describe('personal MCP config and grants', () => {
+  it('accepts personal remote auth but rejects ambiguous auth modes', () => {
+    expect(validateWorkspaceServerConfig(config)).toEqual(config);
+    expect(() => validateWorkspaceServerConfig({ ...config, anythingllm: { perUserAuth: true, perWorkspaceAuth: true } })).toThrow('invalid_anythingllm');
+    expect(() => validateWorkspaceServerConfig({ ...config, anythingllm: { perUserAuth: 'yes' } })).toThrow('invalid_anythingllm');
+    expect(() => validateWorkspaceServerConfig({ command: 'node', anythingllm: { perUserAuth: true } })).toThrow('stdio_not_supported');
+  });
+  it('encrypts tokens and isolates A/B in one workspace without copying legacy tokens', async () => {
+    const grant = await Grant.begin(workspace.id, a.id, 'medusa', config);
+    expect(await Grant.save(workspace.id, a.id, 'medusa', grant.version, config, { access_token: 'private-access', refresh_token: 'private-refresh' })).toBe(true);
+    expect(await Grant.find(workspace.id, b.id, 'medusa', config)).toBeNull();
+    const row = await prisma.personal_mcp_grants.findFirst({ where: { user_id: a.id } });
+    expect(JSON.stringify(row)).not.toMatch(/private-access|private-refresh/);
+    expect(await Grant.find(workspace.id, a.id, 'medusa', config)).toMatchObject({ enabled: true, access_token: 'private-access', refresh_token: 'private-refresh' });
+  });
