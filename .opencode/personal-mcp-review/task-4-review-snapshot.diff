+/* global jest */
+const { describe, it, expect, beforeAll, afterAll, beforeEach, afterEach } = require('@jest/globals');
+require('../utils/lark/_polyfill');
+jest.mock('../../utils/MCP', () => jest.fn());
+const crypto = require('crypto');
+const prisma = require('../../utils/prisma');
+const Layer = require('../../utils/MCP');
+const oauth = require('../../utils/MCP/oauth');
+const { PersonalMcpGrant: Grant } = require('../../models/personalMcpGrant');
+const { mcpOAuthEndpoints } = require('../../endpoints/mcpOAuth');
+let workspace, a, b, routes, config, stop;
+beforeAll(async () => {
+  process.env.JWT_SECRET = 'personal-state-test'; process.env.SERVER_URL = 'https://workspace.example';
+  process.env.SIG_KEY ||= 'test-key'; process.env.SIG_SALT ||= 'test-salt';
+  workspace = await prisma.workspaces.create({ data: { name: 'Personal endpoints', slug: crypto.randomUUID() } });
+  for (const name of ['a', 'b']) {
+    const user = await prisma.users.create({ data: { username: name + crypto.randomUUID(), password: 'unused' } });
+    await prisma.workspace_users.create({ data: { workspace_id: workspace.id, user_id: user.id } });
+    if (name === 'a') a = user; else b = user;
+  }
+});
+beforeEach(async () => {
+  config = { url: 'https://configurable.example/mcp', type: 'http', anythingllm: { perUserAuth: true } };
+  stop = jest.fn().mockResolvedValue();
+  Layer.mockImplementation(() => ({ findServerConfig: async () => ({ server: config }), mcpServerConfigs: [{ name: 'medusa', server: config }], workspaceServerConfigs: async () => [], personalRuntime: { stop, tools: async () => [{ name: 'read' }] } }));
+  jest.spyOn(oauth, 'authorizeUrl').mockImplementation(async args => {
+    const payload = { wsSlug: args.wsSlug, serverName: args.serverName, userId: args.userId, nonce: crypto.randomUUID(), exp: Date.now()+600000 };
+    const encoded = Buffer.from(JSON.stringify(payload)).toString('base64url');
+    const state = encoded + '.' + crypto.createHmac('sha256', process.env.JWT_SECRET).update(encoded).digest('base64url');
+    return { ...payload, state, codeVerifier: 'verifier', url: `https://store.teamredball.com/mcp-auth/authorize?state=${state}` };
+  });
+  jest.spyOn(oauth, 'exchangeCode').mockResolvedValue({ access_token: 'private-access', refresh_token: 'private-refresh' });
+  jest.spyOn(oauth, 'revokeTokens').mockResolvedValue(true);
+  routes = {};
+  const register = (path, middleware, handler) => routes[path] = typeof middleware === 'function' ? { middleware: [], handler: middleware } : { middleware, handler };
+  mcpOAuthEndpoints({ get: register, post: register });
+  await prisma.personal_mcp_grants.deleteMany({ where: { workspace_id: workspace.id } });
+});
+afterEach(async () => { await prisma.lark_oauth_states.deleteMany({ where: { user_id: { in: [a.id,b.id] }, mode: 'mcp' } }); jest.restoreAllMocks(); });
+afterAll(async () => {
+  await prisma.workspaces.delete({ where: { id: workspace.id } });
+  for (const user of [a,b]) await prisma.users.delete({ where: { id: user.id } });
+  await prisma.$disconnect();
+});
+async function invoke(path, user = a, values = {}, verified = true) {
+  const route = routes[path];
+  expect(route).toBeDefined();
+  const req = { params: { workspaceSlug: workspace.slug, serverName: 'medusa', slug: workspace.slug, name: 'medusa' }, query: {}, body: {}, ...values };
+  const res = { locals: { user, multiUserMode: true, ...(verified && user ? { browserSessionUserId: user.id } : {}) }, statusCode: 200,
+    status(code) { this.statusCode = code; return this; }, json(value) { this.body = value; return this; }, sendStatus(code) { this.statusCode = code; return this; }, end() { return this; }, redirect(value) { this.location = value; this.statusCode = 302; return this; } };
+  let allowed = true;
+  // The browser validator is tested independently; execute real authorization guard.
+  for (const middleware of route.middleware.slice(1)) { allowed = false; await middleware(req, res, () => allowed = true); if (!allowed) break; }
+  if (allowed) await route.handler(req, res);
+  return res;
+}
+async function start(user = a) {
+  const res = await invoke('/mcp/oauth/start/:workspaceSlug/:serverName', user, { body: { userId: b.id } });
+  expect(res.statusCode).toBe(200); return new URL(res.body.url).searchParams.get('state');
+}
+async function callback(state) { return invoke('/mcp/oauth/callback', null, { query: { state, code: 'valid' } }); }
+describe('personal OAuth and member surface', () => {
+  it('ordinary members connect only own grant and callback returns to member chat', async () => {
