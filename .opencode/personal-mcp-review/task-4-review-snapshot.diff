+    if (mode === 'suspended') await prisma.users.update({ where: { id: a.id }, data: { suspended: 1 } });
+    if (mode === 'destination') config = { ...config, url: 'https://changed.example/mcp' };
+    const res = await callback(state); expect(res.location).toContain('error=oauth_callback_failed'); expect(oauth.exchangeCode).not.toHaveBeenCalled();
+    if (mode === 'membership') await prisma.workspace_users.create({ data: { workspace_id: workspace.id, user_id: a.id } });
+    if (mode === 'suspended') await prisma.users.update({ where: { id: a.id }, data: { suspended: 0 } });
